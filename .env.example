# ============================================================================
# Mike — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values before running:
#   docker compose up -d
#
# Required values are marked with (required).
# Optional values have sensible defaults or can be left blank to disable
# the feature.
# ============================================================================

# ----------------------------------------------------------------------------
# Public URLs
# ----------------------------------------------------------------------------

# The public URL of the app (used by GoTrue for auth redirects and emails).
# For local dev: http://localhost:4000
# For production: https://yourdomain.com
SITE_URL=http://localhost:4000

# Same as SITE_URL — used by GoTrue for the external API base.
API_EXTERNAL_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# Supabase / Postgres
# ----------------------------------------------------------------------------

# Postgres password — used for all internal Supabase service connections.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=                        # (required)

# JWT secret — must be at least 32 characters. Used to sign Supabase tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET=                               # (required)

# Supabase anon key — a JWT signed with JWT_SECRET + role=anon.
# Generate at: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# Or use the helper: node -e "..."  (see docs/generate-keys.md)
ANON_KEY=                                 # (required)

# Supabase service role key — a JWT signed with JWT_SECRET + role=service_role.
# Gives full DB access — keep this secret.
SERVICE_ROLE_KEY=                         # (required)

# Supabase Realtime encryption key — 32-char hex string.
# Generate with: openssl rand -hex 16
REALTIME_ENC_KEY=                         # (required)

# Supabase Studio / Dashboard credentials (used to access the DB admin UI).
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase

# Phoenix secret key base (for Realtime). Generate with: openssl rand -base64 64
SECRET_KEY_BASE=                          # (required)

# ----------------------------------------------------------------------------
# Mike Backend
# ----------------------------------------------------------------------------

# Secret used to sign file download URLs. Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=                  # (required)

# Secret used to encrypt per-user API keys stored in the database.
# Generate with: openssl rand -hex 32
USER_API_KEYS_ENCRYPTION_SECRET=          # (required)

# ----------------------------------------------------------------------------
# AI Provider Keys
# (All optional — users can also add their own keys in the UI)
# ----------------------------------------------------------------------------

# Concentrate AI — the recommended universal router. Sign up at concentrate.ai
CONCENTRATE_API_KEY=
CONCENTRATE_RESPONSES_URL=                # defaults to https://api.concentrate.ai/v1/responses

# Native provider keys (used when Concentrate is not configured)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# Local LLM Providers (optional)
# ----------------------------------------------------------------------------

# Ollama — enable with: docker compose --profile ollama up
# When using the ollama Docker profile, this MUST be:
#   OLLAMA_BASE_URL=http://ollama:11434/v1/responses
# For external Ollama (not in compose): use its actual URL.
OLLAMA_BASE_URL=http://ollama:11434/v1/responses

# Which Ollama model to pull on first start (ollama-init service).
OLLAMA_MODEL=qwen3:30b-a3b

# vLLM — point at your vLLM server (must speak /v1/responses)
VLLM_BASE_URL=
VLLM_API_KEY=

# Custom OpenAI-Responses-compatible endpoint
GENERIC_BASE_URL=
GENERIC_API_KEY=

# ----------------------------------------------------------------------------
# File Storage (optional — defaults to local disk)
# ----------------------------------------------------------------------------

# Cloudflare R2 (or any S3-compatible) storage for uploaded documents.
# Leave blank to use local disk storage (fine for single-node deployments).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mike

# ----------------------------------------------------------------------------
# Email (optional)
# ----------------------------------------------------------------------------

# SMTP config for sending auth emails (password reset, invite, etc.).
# Leave blank to auto-confirm all signups without email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Mike

# Redirect URLs allowed for email links (comma-separated, wildcards ok).
ADDITIONAL_REDIRECT_URLS=

# Set to true to disable public signup (invite-only deployments).
DISABLE_SIGNUP=false

# ----------------------------------------------------------------------------
# Resend (optional — for transactional email via resend.com)
# ----------------------------------------------------------------------------
RESEND_API_KEY=
