# ============================================================================
# Mike — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values before running:
#   docker compose up -d
#
# Required values are marked with (required).
# ============================================================================

# ----------------------------------------------------------------------------
# App URL
# The public URL of the app — used for auth redirects.
# For local dev: http://localhost:4000
# For production: https://yourdomain.com
# ----------------------------------------------------------------------------
SITE_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# Supabase
# Mike uses Supabase for auth and database. Two options:
#
# Option A — Supabase Cloud (recommended for production):
#   Create a project at supabase.com and copy the URL and keys from
#   Project Settings → API.
#
# Option B — Self-hosted local (for development):
#   Run `supabase start` in this directory, then run `supabase status`
#   to get the URL and keys. Set SUPABASE_URL to use host-gateway so
#   the Docker container can reach the host:
#     SUPABASE_URL=http://host-gateway:54321
# ----------------------------------------------------------------------------

# Supabase project URL (e.g. https://xxxx.supabase.co or http://host-gateway:54321)
SUPABASE_URL=                             # (required)

# Supabase anon/publishable key — safe to expose to the browser
SUPABASE_ANON_KEY=                        # (required)

# Supabase service role key — secret, gives full DB access
SUPABASE_SECRET_KEY=                      # (required)

# ----------------------------------------------------------------------------
# Mike Backend
# ----------------------------------------------------------------------------

# Secret used to sign file download URLs.
# Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=                  # (required)

# Secret used to encrypt per-user API keys stored in the database.
# Generate with: openssl rand -hex 32
USER_API_KEYS_ENCRYPTION_SECRET=          # (required)

# ----------------------------------------------------------------------------
# AI Provider Keys
# All optional — users can also add their own keys in the Settings UI.
# At least one provider key (or CONCENTRATE_API_KEY) should be set.
# ----------------------------------------------------------------------------

# Concentrate AI — universal model router (sign up at concentrate.ai)
CONCENTRATE_API_KEY=
CONCENTRATE_RESPONSES_URL=                # leave blank to use the default

# Native provider keys (used when Concentrate is not configured)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# Local LLM Providers (optional)
# ----------------------------------------------------------------------------

# Ollama — enable with: docker compose --profile ollama up
# When using the ollama Docker profile, this MUST use the service name:
#   OLLAMA_BASE_URL=http://ollama:11434/v1/responses
# For an external Ollama instance: use its actual URL.
OLLAMA_BASE_URL=http://ollama:11434/v1/responses

# Which Ollama model to pull on first start (via the ollama-init service).
OLLAMA_MODEL=qwen3:30b-a3b

# vLLM — point at your vLLM server (must speak /v1/responses)
VLLM_BASE_URL=
VLLM_API_KEY=

# Custom OpenAI-Responses-compatible endpoint
GENERIC_BASE_URL=
GENERIC_API_KEY=

# ----------------------------------------------------------------------------
# File Storage (optional — defaults to local disk)
# Cloudflare R2 (or any S3-compatible) storage for uploaded documents.
# ----------------------------------------------------------------------------
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mike

# ----------------------------------------------------------------------------
# Email (optional)
# SMTP config for transactional email (password reset, invites).
# Configured in your Supabase project — not needed here unless using
# self-hosted Supabase.
# ----------------------------------------------------------------------------
RESEND_API_KEY=

# ----------------------------------------------------------------------------
# Frontend port (optional, default 4000)
# ----------------------------------------------------------------------------
PORT=4000
