# Supabase — anon/publishable key (from supabase start or Supabase Cloud dashboard)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key

# Supabase service role key (server-side only — never exposed to the browser)
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Backend API base URL — keep as /api/backend (relative, works on any hostname)
# The Next.js proxy routes this to BACKEND_INTERNAL_URL (default localhost:3001)
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Override internal service locations if they run on non-default ports:
# BACKEND_INTERNAL_URL=http://localhost:3001
# SUPABASE_INTERNAL_URL=http://localhost:54321
